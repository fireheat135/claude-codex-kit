#!/usr/bin/env bash
# Usage: codex-image "<prompt>" [out.png]  -> Codex's built-in image generation; prints the absolute path.
# Env: CODEX_IMAGE_TIMEOUT (sec, default 300)
set -uo pipefail
src=$0; while [ -L "$src" ]; do t=$(readlink "$src"); case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac; done
# shellcheck source=_common.sh
. "$(cd "$(dirname "$src")" && pwd)/_common.sh"
[ $# -ge 1 ] || { echo 'Usage: codex-image "<prompt>" [out.png]' >&2; exit 64; }
prompt=$1; out=$(abspath "${2:-image.png}")
need_login || exit $?
marker=$(mktemp)   # files newer than this were generated by this run
run_timeout "${CODEX_IMAGE_TIMEOUT:-300}" codex exec --skip-git-repo-check --enable image_generation \
  -s workspace-write -C "$(dirname "$out")" \
  "Use your built-in image generation tool (not a script or API) to create: ${prompt}. Copy the generated PNG to ${out}. Reply only with that path." \
  </dev/null >&2 || echo "codex exit $?" >&2
if [ ! -s "$out" ] && [ -d "$HOME/.codex/generated_images" ]; then   # recover if the copy step was skipped
  newest=$(find "$HOME/.codex/generated_images" -name '*.png' -newer "$marker" -exec ls -t {} + 2>/dev/null | head -1)
  [ -n "$newest" ] && cp "$newest" "$out"
fi
rm -f "$marker"
if [ -s "$out" ]; then echo "$out"; else echo "image not saved" >&2; exit 1; fi
